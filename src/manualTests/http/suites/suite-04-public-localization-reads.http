@baseUrl = http://localhost:8080
@report = no-report-available
@report_file = ../reports/fake_report.md
@test_idx = 1

### Suite 04 — Public Localization Reads
# @name suite_04_setup
GET {{baseUrl}}/hello

> {%
    var date = new Date().toISOString().split('T')[0];
    client.global.set("report_file", "../reports/04-public-localization-reads_raport_" + date + ".md");
    var baseUrl = client.variables.environment.get("baseUrl") || client.global.get("baseUrl") || client.variables.file.get("baseUrl");
    var report = "# Manual Regression Report - Suite 04\n\n";
    report += "- Suite: `04-public-localization-reads`\n";
    report += "- Run Date: " + new Date().toString() + "\n";
    report += "- Base URL: " + baseUrl + "\n\n";
    report += "## Test Results\n\n";
    report += "| # | Test | Method | Path | Status | Result | Note |\n";
    report += "|---|------|--------|------|--------|--------|------|\n";
    client.global.set("report", report);
    client.global.set("test_idx", 1);
%}

### 04-1 List Localizations
# @name list_localizations
GET {{baseUrl}}/api/localizations?page=0&size=5&sort=messageKey,asc&sort=language,asc
Accept: application/json

> {%
    var idx = client.global.get("test_idx") || 1;
    var report = client.global.get("report") || "";
    var result = response.status === 200 ? "PASS" : "FAIL";
    report += "| " + idx + " | listLocalizationsWithPagination | GET | /api/localizations | " + response.status + " | " + result + " | paginated localization list |\n";
    client.global.set("report", report);
    client.global.set("test_idx", idx + 1);

    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 04-2 Filter Localization
# @name filter_localization
GET {{baseUrl}}/api/localizations?messageKey=error.book.not_found&language=en
Accept: application/json

> {%
    var idx = client.global.get("test_idx") || 1;
    var report = client.global.get("report") || "";
    var result = response.status === 200 ? "PASS" : "FAIL";
    report += "| " + idx + " | filterByKnownKey | GET | /api/localizations | " + response.status + " | " + result + " | filter by known message key |\n";
    client.global.set("report", report);
    client.global.set("test_idx", idx + 1);

    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("ETag header is present", function() {
        client.assert(response.headers.valueOf("ETag") !== null, "ETag header is missing");
    });
    client.global.set("localizationEtag", response.headers.valueOf("ETag"));

    if (response.body && response.body.content && response.body.content.length > 0) {
        client.global.set("firstLocalizationId", response.body.content[0].id);
        client.log("Captured firstLocalizationId: " + response.body.content[0].id);
    }
%}

### 04-3 Revalidate Filtered Localization List
# @name revalidate_localization_list
GET {{baseUrl}}/api/localizations?messageKey=error.book.not_found&language=en
Accept: application/json
If-None-Match: {{localizationEtag}}

> {%
    var idx = client.global.get("test_idx") || 1;
    var report = client.global.get("report") || "";
    var result = response.status === 304 ? "PASS" : "FAIL";
    report += "| " + idx + " | revalidateWithIfNoneMatch | GET | /api/localizations | " + response.status + " | " + result + " | conditional read returns 304 Not Modified |\n";
    client.global.set("report", report);
    client.global.set("test_idx", idx + 1);

    client.test("Status is 304", function() {
        client.assert(response.status === 304, "Response status is not 304");
    });
%}

### Finalize Report
< {%
    request.variables.set("reportBody", client.global.get("report") || client.variables.file.get("report"));
    request.variables.set("reportFile", client.global.get("report_file") || client.variables.file.get("report_file"));
%}
POST {{baseUrl}}/debug/echo
Content-Type: text/plain

{{reportBody}}

>>! {{reportFile}}

> {%
    client.log("Report saved to: " + (client.global.get("report_file") || client.variables.file.get("report_file")));
    client.log(client.global.get("report") || client.variables.file.get("report"));
%}
